#!/usr/bin/env bash
# zim-claude — run Claude Code against Coarena.
#
# Coarena (https://coarena.ai) runs a free Model API in front of a frontier
# lineup, and it speaks the Anthropic Messages protocol natively at
# /api/v1/messages — so Claude Code talks to it directly and no proxy is
# involved. This wrapper points a single `claude` process at it.
#
# Every argument is forwarded verbatim to `claude`. This script deliberately
# parses NO options of its own: `zim-claude --help`, `zim-claude mcp list`,
# `zim-claude -p "..."` and every other Claude Code flag/subcommand must reach
# claude unchanged. Configure this script through environment variables only.
# The one argument it adds is `--settings`, described under "the model picker
# inside Claude Code" below, and it is skipped entirely if you pass your own.
#
# What a run does:
#
#   1. takes a Coarena key from the environment, the state dir, or a prompt
#   2. validates it against GET /v1/limits (401 without a key, 200 with one)
#   3. fetches the public catalog from GET /v1/models
#   4. lets the user pick a model, defaulting to DeepSeek V4.1 Flash
#   5. writes a session settings file so `/model` lists every Coarena model
#   6. exports ANTHROPIC_* for this process only, then execs claude
#
#   ZIM_CLAUDE_API_KEY            key to use; skips the prompt and the cache
#                                 (COARENA_API_KEY is accepted too)
#   ZIM_CLAUDE_MODEL              model id to use; skips the picker
#   ZIM_CLAUDE_BASE_URL           API base URL  (default https://coarena.ai/api)
#   ZIM_CLAUDE_BIN                claude binary (default: `claude` on PATH)
#   ZIM_CLAUDE_STATE_DIR          key cache, last pick and the settings file
#   ZIM_CLAUDE_NO_UPDATE=1        never auto-update
#   ZIM_CLAUDE_NO_PICKER=1        do not add Coarena models to `/model`

set -euo pipefail

# Self-locating, so a symlinked or relocated install still finds its sibling
# updater. Resolved without `readlink -f`: that flag is GNU-only and this
# package claims macOS support.
_zc_src="${BASH_SOURCE[0]}"
while [[ -L "$_zc_src" ]]; do
  _zc_dir="$(cd -P -- "$(dirname -- "$_zc_src")" && pwd)"
  _zc_src="$(readlink -- "$_zc_src")"
  [[ "$_zc_src" != /* ]] && _zc_src="$_zc_dir/$_zc_src"
done
_self_dir="$(cd -P -- "$(dirname -- "$_zc_src")" && pwd)"

# The Messages root, NOT /api/v1. The Anthropic SDK appends /v1/messages to
# whatever base it is handed, so this composes to /api/v1/messages. Handing it
# /api/v1 would compose to /api/v1/v1/messages and 404 on every turn while the
# catalog still worked — the provider's own docs name this exact base.
BASE_URL="${ZIM_CLAUDE_BASE_URL:-https://coarena.ai/api}"
BASE_URL="${BASE_URL%/}"
STATE_DIR="${ZIM_CLAUDE_STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/zim-claude}"
LAST_MODEL_FILE="$STATE_DIR/last-model"
KEY_FILE="$STATE_DIR/coarena.key"
SETTINGS_FILE="$STATE_DIR/claude-settings.json"

# The model a fresh install starts on. DeepSeek V4.1 Flash is the fastest
# tool-capable entry in the catalog and the one this package defaults to.
# Every model on Coarena is priced at 0 in and 0 out, so this is a speed
# choice, not a cost one — see the budget line the picker prints.
DEFAULT_MODEL="deepseek-v4-1-flash-1017"

CLAUDE_BIN="${ZIM_CLAUDE_BIN:-$(command -v claude 2>/dev/null || true)}"

# All diagnostics go to stderr: `zim-claude -p "x" --output-format json | jq`
# must stay parseable, and the model menu must not pollute stdout either.
die()  { printf '\033[31m[zim-claude]\033[0m %s\n' "$*" >&2; exit 2; }
warn() { printf '\033[33m[zim-claude]\033[0m %s\n' "$*" >&2; }
info() { printf '\033[36m[zim-claude]\033[0m %s\n' "$*" >&2; }

# --- preconditions -----------------------------------------------------------

[[ -n "$CLAUDE_BIN" ]] \
  || die "claude not found on PATH. Install Claude Code, or set ZIM_CLAUDE_BIN."

# Check it is actually runnable: exec'ing a missing file would surface as a
# bare 127 with no explanation.
[[ -x "$CLAUDE_BIN" ]] \
  || die "claude is not executable: $CLAUDE_BIN"

command -v curl >/dev/null 2>&1 \
  || die "curl is required to reach $BASE_URL, and it is not on PATH."

# --- the terminal ------------------------------------------------------------
#
# Prompts go through /dev/tty rather than stdin, so `zim-claude -p x < file`
# still asks on the terminal the user is looking at. Opening it also tells us
# whether there IS a terminal, which decides whether a missing answer is a
# prompt or a hard error.

_tty_open=0
open_tty() {
  (( _tty_open )) && return 0
  if { exec 3</dev/tty; } 2>/dev/null; then
    _tty_open=1
    return 0
  fi
  return 1
}

close_tty() {
  (( _tty_open )) || return 0
  exec 3<&-
  _tty_open=0
}

# Strip what a copy-paste adds. A trailing CR or space inside the token is a
# 401 that looks like a bad key.
sanitize() {
  printf '%s' "$1" | tr -d ' \t\r\n'
}

# --- the API key -------------------------------------------------------------

API_KEY="${ZIM_CLAUDE_API_KEY:-${COARENA_API_KEY:-}}"
API_KEY="$(sanitize "$API_KEY")"

if [[ -z "$API_KEY" && -s "$KEY_FILE" ]]; then
  API_KEY="$(sanitize "$(cat "$KEY_FILE" 2>/dev/null || true)")"
fi

# A key that arrived from the environment is not the user's to retype: if it is
# rejected, say so and stop. Only a key typed at the prompt is worth re-asking.
key_from_env=0
[[ -n "${ZIM_CLAUDE_API_KEY:-}${COARENA_API_KEY:-}" ]] && key_from_env=1

# A key from a provider this package no longer routes to cannot work here, and
# silently sending it to Coarena would read as "your key is broken". Name the
# real reason.
case "$API_KEY" in
  tj_*)
    die "that is a Token Juice key (tj_...), and this package no longer routes there.
       Create a Coarena key at https://coarena.ai/account/api." ;;
  thk_*)
    die "that is a TokenHarbor key (thk_...), and this package now routes to Coarena.
       Create a Coarena key at https://coarena.ai/account/api." ;;
esac

# The same rule for the base URL: pointing zim-claude at a provider this
# package no longer supports is not a configuration worth running.
case "${ZIM_CLAUDE_BASE_URL:-}" in
  *tokenjuice*|*tokenharbor*)
    die "ZIM_CLAUDE_BASE_URL names a provider this package no longer routes to.
       Unset ZIM_CLAUDE_BASE_URL to use Coarena (https://coarena.ai/api)." ;;
esac

ask_key() {
  open_tty || return 1
  printf '\n' >&2
  info "Coarena API key — create one at https://coarena.ai/account/api"
  printf '  paste it here (input is hidden): ' >&2
  local typed=""
  IFS= read -r -s typed <&3 || typed=""
  printf '\n' >&2
  API_KEY="$(sanitize "$typed")"
  [[ -n "$API_KEY" ]]
}

# Cache the key the user typed, so the prompt is a first-run cost and not a
# per-session tax. Mode 600 in the state dir, next to the other bookkeeping.
remember_key() {
  [[ -n "$API_KEY" ]] || return 0
  (( key_from_env )) && return 0
  [[ -s "$KEY_FILE" && "$(sanitize "$(cat "$KEY_FILE" 2>/dev/null || true)")" == "$API_KEY" ]] && return 0
  mkdir -p -- "$STATE_DIR" 2>/dev/null || return 0
  chmod 700 -- "$STATE_DIR" 2>/dev/null || true
  ( umask 077; printf '%s\n' "$API_KEY" >"$KEY_FILE" ) 2>/dev/null || true
  chmod 600 -- "$KEY_FILE" 2>/dev/null || true
}

# --- talking to Coarena ------------------------------------------------------

HTTP_CODE=""
HTTP_BODY=""
#: The /v1/limits payload, kept separately: the picker prints the day's
#: remaining budget, and by the time it runs HTTP_BODY holds the catalog.
LIMITS_BODY=""

api_get() {
  local out
  # -sS would print curl's own error to stderr; capture the body and status and
  # report both ourselves so the message names the host that failed.
  out="$(curl -sS --max-time 20 \
           -H "Authorization: Bearer $API_KEY" \
           -H 'Accept: application/json' \
           -w $'\n%{http_code}' \
           "$BASE_URL$1" 2>/dev/null)" || out=$'\n000'
  HTTP_CODE="${out##*$'\n'}"
  HTTP_BODY="${out%$'\n'*}"
  [[ "$HTTP_CODE" =~ ^[0-9]{3}$ ]] || HTTP_CODE=000
}

# Pull `"id":"..."` out of the models payload. grep/sed only — jq and python3
# are not dependencies of this package, and the shape here is one flat list.
parse_model_ids() {
  grep -oE '"id"[[:space:]]*:[[:space:]]*"[^"]+"' \
    | sed -E 's/.*"id"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/'
}

# `id<TAB>display_name<TAB>context_length` per model, when python3 is around to
# read the JSON properly. Falls back to bare ids, which the picker then labels
# with the id — a cosmetic loss, never a functional one.
#
# The context length is carried because Claude Code has no catalog entry for a
# non-Anthropic id and therefore assumes a 1M-token window for it. Coarena's
# models are 128k, so that guess is 8x too generous and auto-compact would fire
# far too late — the request would 400 on length before compaction ever ran.
# The wrapper feeds the real number to CLAUDE_CODE_AUTO_COMPACT_WINDOW.
parse_models() {
  if command -v python3 >/dev/null 2>&1; then
    printf '%s' "$HTTP_BODY" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin).get("data") or []
except Exception:
    sys.exit(0)
for e in data:
    if not isinstance(e, dict):
        continue
    mid = str(e.get("id") or "").strip()
    if not mid:
        continue
    name = str(e.get("display_name") or "").strip()
    ctx = e.get("context_length")
    ctx = str(ctx) if isinstance(ctx, int) and ctx > 0 else ""
    print(mid + "\t" + name + "\t" + ctx)
' 2>/dev/null && return 0
  fi
  local id
  while IFS= read -r id; do
    [[ -n "$id" ]] && printf '%s\t\t\n' "$id"
  done <<<"$(printf '%s\n' "$HTTP_BODY" | parse_model_ids || true)"
}

# The context window the catalog advertises for one model id, or empty when the
# payload did not carry one (no python3, or an older catalog).
model_context_length() {
  local line id ctx
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    id="${line%%$'\t'*}"
    [[ "$id" == "$1" ]] || continue
    ctx="${line##*$'\t'}"
    [[ "$ctx" =~ ^[0-9]+$ ]] && printf '%s' "$ctx"
    return 0
  done <<<"$ALL_MODELS"
  return 0
}

# The day's remaining allowance, from the /limits payload. Printed beside the
# model list because "free" here means no per-token charge, not no ceiling: the
# account is metered in real dollars against a daily budget. Best-effort — a
# payload we cannot read simply prints nothing.
budget_line() {
  command -v python3 >/dev/null 2>&1 || return 0
  [[ -n "$LIMITS_BODY" ]] || return 0
  printf '%s' "$LIMITS_BODY" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin).get("data") or {}
    today = d.get("today") or {}
    left = today.get("left_usd")
    cap = d.get("usd_per_day")
    if left is None or cap is None:
        sys.exit(0)
    print(f"${left:.2f} of ${cap:.2f} left today")
except Exception:
    pass
' 2>/dev/null || true
}

# --- the model picker --------------------------------------------------------

MODEL=""
ALL_MODELS=""   # id<TAB>display_name<TAB>context_length lines

choose_model() {
  local -a ids=() labels=()
  local line id label rest

  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    id="${line%%$'\t'*}"
    rest="${line#*$'\t'}"
    label="${rest%%$'\t'*}"
    [[ -n "$id" ]] || continue
    ids+=("$id")
    labels+=("$label")
  done <<<"$ALL_MODELS"

  (( ${#ids[@]} > 0 )) || die "$BASE_URL/v1/models returned no models."

  # A pinned model is an override, not a preference: take it as given so a
  # script can pin a model without the picker getting in the way.
  if [[ -n "${ZIM_CLAUDE_MODEL:-}" ]]; then
    MODEL="$ZIM_CLAUDE_MODEL"
    return 0
  fi

  # Default to last time's pick when it is still on offer, so pressing Enter
  # repeatedly is stable instead of drifting to whatever sorts first. A fresh
  # install starts on DEFAULT_MODEL when the catalog still lists it.
  local default_n=1 previous=""
  if [[ -r "$LAST_MODEL_FILE" ]]; then
    previous="$(sanitize "$(cat "$LAST_MODEL_FILE" 2>/dev/null || true)")"
  fi
  [[ -n "$previous" ]] || previous="$DEFAULT_MODEL"
  local i
  for i in "${!ids[@]}"; do
    if [[ "${ids[$i]}" == "$previous" ]]; then
      default_n=$((i + 1))
    fi
  done

  open_tty || die "no terminal to choose a model on.
       Set ZIM_CLAUDE_MODEL=<model-id> to skip the picker."

  local budget; budget="$(budget_line)"
  printf '\n' >&2
  if [[ -n "$budget" ]]; then
    info "models on ${BASE_URL#https://} — $budget"
  else
    info "models on ${BASE_URL#https://}"
  fi
  for i in "${!ids[@]}"; do
    label="${labels[$i]}"
    if [[ -n "$label" ]]; then
      printf '  %2d) %-26s %s\n' "$((i + 1))" "${ids[$i]}" "$label" >&2
    else
      printf '  %2d) %s\n' "$((i + 1))" "${ids[$i]}" >&2
    fi
  done

  local reply="" choice=""
  while :; do
    printf '  select 1-%d [%d]: ' "${#ids[@]}" "$default_n" >&2
    IFS= read -r reply <&3 || reply=""
    reply="$(sanitize "$reply")"
    [[ -z "$reply" ]] && reply="$default_n"
    if [[ "$reply" =~ ^[0-9]+$ ]] && (( reply >= 1 && reply <= ${#ids[@]} )); then
      choice="${ids[$((reply - 1))]}"
      break
    fi
    warn "not a choice: $reply"
  done
  MODEL="$choice"
}

remember_model() {
  [[ -n "$MODEL" ]] || return 0
  mkdir -p -- "$STATE_DIR" 2>/dev/null || return 0
  chmod 700 -- "$STATE_DIR" 2>/dev/null || true
  printf '%s\n' "$MODEL" >"$LAST_MODEL_FILE" 2>/dev/null || true
}

# --- the model picker inside Claude Code -------------------------------------
#
# `/model` lists Claude Code's built-in lineup, which knows nothing about
# Coarena's ids. Two mechanisms can change that:
#
#   * CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1 asks Claude Code to read
#     /v1/models itself — but it keeps only ids containing "claude" or
#     "anthropic", so on Coarena it would surface only the Claude ids and hide
#     deepseek, gemini, kimi, grok, qwen, glm, hy4, mimo and minimax.
#   * the `modelPicker` settings key lists any id, in any order, under any
#     label, with no filter at all.
#
# So the wrapper writes a settings file and passes it with `--settings`, which
# applies to this session only. Nothing is written to ~/.claude/settings.json:
# these models exist only while routed through Coarena, and a plain `claude`
# in another terminal must not inherit them.
#
# `replaceBuiltInOptions` is on because the built-in rows (Opus 5.5, Sonnet
# 5.5, ...) are Anthropic-API ids that Coarena does not serve under those
# names; leaving them in the picker would offer rows that 404 on selection.
#
# `behavesAs` is set on the rows Claude Code does not know — every non-Claude
# id. Without it Claude Code has no catalog entry for the model, so it assumes
# a 1M-token window and prints a warning on every single run:
#
#   Claude Code doesn't recognize the model "deepseek-v4-1-flash-1017", so it
#   assumes a context window of 1m tokens.
#
# `behavesAs` borrows a known model's client-side handling (prompt profile,
# capability and effort defaults) without changing the id that is sent. It
# does NOT set the window — it inherits the borrowed model's, which is 200k for
# claude-sonnet-4-5 — so the real 128k is applied separately through
# CLAUDE_CODE_AUTO_COMPACT_WINDOW below. The two together are what make a
# Coarena session quiet and correctly bounded; either one alone is not.
#
# Claude ids are left alone: Claude Code already knows them, and overriding
# their handling would be a downgrade.

# The model whose client-side handling a non-Claude Coarena id borrows. Sonnet
# is the closest match for a general tool-calling model, and it is a stable id
# that will not be retired out from under the picker.
BEHAVES_AS="claude-sonnet-4-5"

json_escape() {
  # Model ids are [a-z0-9.-] and display names are plain text, but a stray
  # quote or backslash must not produce a settings file Claude Code rejects.
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# Set by write_settings_file when a file was actually produced. The hand-off
# below keys off this rather than off the file's existence: a file left by an
# earlier run must not be passed once ZIM_CLAUDE_NO_PICKER=1 is set.
SETTINGS_WRITTEN=0

write_settings_file() {
  SETTINGS_WRITTEN=0
  [[ "${ZIM_CLAUDE_NO_PICKER:-0}" == "1" ]] && return 0

  local line id label rest first=1
  local body=""
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    id="${line%%$'\t'*}"
    rest="${line#*$'\t'}"
    label="${rest%%$'\t'*}"
    [[ -n "$id" ]] || continue
    [[ -n "$label" ]] || label="$id"
    (( first )) || body+=","$'\n'
    first=0
    body+="    {\"model\": \"$(json_escape "$id")\", \"label\": \"$(json_escape "$label")\""
    # Only ids Claude Code does not already know need the borrowed handling.
    case "$id" in
      claude-*) ;;
      *) body+=", \"behavesAs\": \"$(json_escape "$BEHAVES_AS")\"" ;;
    esac
    body+="}"
  done <<<"$ALL_MODELS"

  [[ -n "$body" ]] || return 0

  mkdir -p -- "$STATE_DIR" 2>/dev/null || return 0
  chmod 700 -- "$STATE_DIR" 2>/dev/null || true
  {
    printf '{\n'
    printf '  "modelPicker": {\n'
    printf '    "replaceBuiltInOptions": true,\n'
    printf '    "options": [\n'
    printf '%s\n' "$body"
    printf '    ]\n'
    printf '  }\n'
    printf '}\n'
  } >"$SETTINGS_FILE" 2>/dev/null || return 0
  chmod 600 -- "$SETTINGS_FILE" 2>/dev/null || true
  SETTINGS_WRITTEN=1
}

# --- validate the key and fetch the catalog ----------------------------------

_prev_base_url="${ANTHROPIC_BASE_URL:-}"
attempt=0

while :; do
  if [[ -z "$API_KEY" ]]; then
    if ! ask_key; then
      die "a Coarena API key is required.
       Get one at https://coarena.ai/account/api, then either paste it when
       prompted, or export ZIM_CLAUDE_API_KEY and re-run."
    fi
  fi

  # /v1/limits is the credential probe: 401 without a key, 200 with one. The
  # catalog at /v1/models answers 200 with no key at all, so it cannot tell a
  # good key from a missing one — probing it would accept any string.
  api_get /v1/limits

  case "$HTTP_CODE" in
    200) LIMITS_BODY="$HTTP_BODY"; break ;;
    401|403)
      if (( key_from_env )); then
        die "Coarena rejected ZIM_CLAUDE_API_KEY (HTTP $HTTP_CODE).
       Rotate it at https://coarena.ai/account/api."
      fi
      attempt=$((attempt + 1))
      warn "Coarena rejected that key (HTTP $HTTP_CODE)."
      if (( attempt >= 3 )); then
        die "giving up after 3 rejected keys.
       Create or rotate one at https://coarena.ai/account/api."
      fi
      rm -f -- "$KEY_FILE" 2>/dev/null || true
      API_KEY=""
      continue
      ;;
    000)
      die "could not reach $BASE_URL.
       Check your connection, or set ZIM_CLAUDE_BASE_URL if the API lives
       somewhere else."
      ;;
    *)
      die "$BASE_URL/v1/limits answered HTTP $HTTP_CODE.
       ${HTTP_BODY:0:300}"
      ;;
  esac
done

remember_key

# The catalog is public, so this is a second request rather than a reuse of the
# probe above — /limits carries the budget, /models carries the lineup.
api_get /v1/models
case "$HTTP_CODE" in
  200) ;;
  000) die "could not reach $BASE_URL/v1/models.
       Check your connection, or set ZIM_CLAUDE_BASE_URL." ;;
  *)   die "$BASE_URL/v1/models answered HTTP $HTTP_CODE.
       ${HTTP_BODY:0:300}" ;;
esac

ALL_MODELS="$(parse_models || true)"
[[ -n "$ALL_MODELS" ]] \
  || die "$BASE_URL/v1/models returned no model ids.
       ${HTTP_BODY:0:300}"

choose_model
remember_model
write_settings_file

# --- hand off ----------------------------------------------------------------

close_tty

# Report the override rather than silently changing provider.
if [[ -n "$_prev_base_url" && "$_prev_base_url" != "$BASE_URL" ]]; then
  case "$_prev_base_url" in
    *tokenjuice*|*tokenharbor*|*localhost:4*|*127.0.0.1:4*)
      warn "ignoring inherited ANTHROPIC_BASE_URL=$_prev_base_url" ;;
    *)
      warn "overriding inherited ANTHROPIC_BASE_URL=$_prev_base_url -> $BASE_URL" ;;
  esac
fi

info "model: $MODEL"

# Process-scoped only: plain `claude` in this shell is untouched.
export ANTHROPIC_BASE_URL="$BASE_URL"
export ANTHROPIC_AUTH_TOKEN="$API_KEY"
export ANTHROPIC_MODEL="$MODEL"

# Claude Code names its background and /model-picker calls after Anthropic
# tiers. There is no proxy to rewrite those names, so point every tier at the
# model that was chosen — otherwise `/model sonnet` asks Coarena for
# "claude-sonnet-4-5" and gets a 404.
export ANTHROPIC_SMALL_FAST_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL"

# Load-bearing. Claude Code prefers ANTHROPIC_AUTH_TOKEN (sent as
# `Authorization: Bearer ...`) and falls back to ANTHROPIC_API_KEY (`x-api-key`)
# on a truthiness test, so an empty string means the auth token wins — and it
# also clears any real ANTHROPIC_API_KEY inherited from the shell.
export ANTHROPIC_API_KEY=""

# --- the settings argument ---------------------------------------------------
#
# `--settings` is the one argument this wrapper adds. It is skipped when the
# user passes their own, because two --settings flags would fight and theirs is
# the one that should win.

_claude_args=()
_user_has_settings=0
for _a in "$@"; do
  case "$_a" in
    --settings|--settings=*) _user_has_settings=1 ;;
  esac
done

if (( _user_has_settings )); then
  warn "your --settings wins; Coarena models will not be added to /model"
elif (( SETTINGS_WRITTEN )) && [[ -s "$SETTINGS_FILE" ]]; then
  _claude_args+=(--settings "$SETTINGS_FILE")
fi

# --- the context window ------------------------------------------------------
#
# Claude Code has no catalog entry for a non-Anthropic id, so it assumes a
# 1M-token window. Coarena's models are 128k. Left alone, auto-compact would
# wait for 1M tokens of history and the request would 400 on length long before
# that — the session dies instead of compacting.
#
# CLAUDE_CODE_AUTO_COMPACT_WINDOW is the lever that actually moves the window
# Claude Code plans against (CLAUDE_CODE_MAX_CONTEXT_TOKENS only silences the
# warning and leaves the 1M assumption in place). The number comes from the
# catalog's own context_length, so it follows the model rather than being
# hardcoded here.
#
# Only set when the catalog gave us a number: an unset variable is better than
# a wrong one, and Claude Code's own default is right for a Claude id.
_ctx="$(model_context_length "$MODEL")"
if [[ -n "$_ctx" ]]; then
  export CLAUDE_CODE_AUTO_COMPACT_WINDOW="$_ctx"
fi

# --- self-update -------------------------------------------------------------

# Bring the installed package up to date in the background. Detached and
# disowned so it can never delay, block or fail this session; the updater
# rate-limits itself, refuses a dirty checkout, and only fast-forwards.
maybe_self_update() {
  [[ "${ZIM_CLAUDE_NO_UPDATE:-0}" == "1" ]] && return 0

  local updater="$_self_dir/zim-claude-update.sh"
  [[ -x "$updater" ]] || return 0

  # setsid detaches from the terminal's process group so a Ctrl-C, a closed
  # window or a hangup does not kill a half-finished update. Fall back to a
  # plain background job where setsid is unavailable (macOS).
  if command -v setsid >/dev/null 2>&1; then
    setsid "$updater" >/dev/null 2>&1 </dev/null &
  else
    "$updater" >/dev/null 2>&1 </dev/null &
  fi
  disown 2>/dev/null || true
  return 0
}

maybe_self_update

# exec: no extra bash layer, so exit status, signal delivery and TTY ownership
# all belong to claude. NOTE: exec discards EXIT traps — do not add one here.
exec "$CLAUDE_BIN" "${_claude_args[@]}" "$@"
