#!/usr/bin/env bash
# zim-claude — run Claude Code against TokenHarbor.
#
# Token Juice is down: its unlimited quota ended, so this wrapper no longer
# routes to it. Nothing here reads the ~/tokenjuice/ profile or the key file
# that ships in the checkout — a `tj_…` key is refused outright. Every run says
# so once on stderr and offers TokenHarbor instead; the answer is remembered.
#
# Every argument is forwarded verbatim to `claude`. This script deliberately
# parses NO options of its own: `zim-claude --help`, `zim-claude mcp list`,
# `zim-claude -p "..."` and every other Claude Code flag/subcommand must reach
# claude unchanged. Configure this script through environment variables only.
#
# What a run does:
#
#   1. reports that Token Juice is down (until a key of the user's own is set)
#   2. offers TokenHarbor once, and remembers a yes
#   3. takes a TokenHarbor key from the environment, the state dir, or a prompt
#   4. validates it against GET /v1/models and lets the user pick a model
#   5. exports ANTHROPIC_* for this process only, then execs claude
#
# No proxy is involved. TokenHarbor serves the Anthropic Messages API natively
# at /v1/messages, so Claude Code talks to it directly.
#
#   ZIM_CLAUDE_USE_TOKENHARBOR=1  use TokenHarbor without asking
#   ZIM_CLAUDE_USE_TOKENHARBOR=0  never use TokenHarbor (exit 2 with the notice)
#   ZIM_CLAUDE_API_KEY            key to use; skips the prompt and the cache
#                                 (TOKENHARBOR_API_KEY is accepted too)
#   ZIM_CLAUDE_MODEL              model id to use; skips the picker
#   ZIM_CLAUDE_BASE_URL           API base URL  (default https://tokenharbor.ai)
#   ZIM_CLAUDE_BIN                claude binary (default: `claude` on PATH)
#   ZIM_CLAUDE_STATE_DIR          route, key cache and last pick
#   ZIM_CLAUDE_NO_UPDATE=1        never auto-update

set -euo pipefail

# Self-locating, so a symlinked or relocated install still finds its sibling
# updater. Resolved without `readlink -f`: that flag is GNU-only and this
# package claims macOS support.
_zc_src="${BASH_SOURCE[0]}"
while [[ -L "$_zc_src" ]]; do
  _zc_dir="$(cd -P -- "$(dirname -- "$_zc_src")" && pwd)"
  _zc_src="$(readlink -- "$_zc_src")"
  [[ "$_zc_src" != /* ]] && _zc_src="$_zc_dir/$_zc_src"
done
_self_dir="$(cd -P -- "$(dirname -- "$_zc_src")" && pwd)"

BASE_URL="${ZIM_CLAUDE_BASE_URL:-https://tokenharbor.ai}"
BASE_URL="${BASE_URL%/}"
STATE_DIR="${ZIM_CLAUDE_STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/zim-claude}"
LAST_MODEL_FILE="$STATE_DIR/last-model"
ROUTE_FILE="$STATE_DIR/route"
KEY_FILE="$STATE_DIR/tokenharbor.key"

CLAUDE_BIN="${ZIM_CLAUDE_BIN:-$(command -v claude 2>/dev/null || true)}"

# All diagnostics go to stderr: `zim-claude -p "x" --output-format json | jq`
# must stay parseable, and the model menu must not pollute stdout either.
die()  { printf '\033[31m[zim-claude]\033[0m %s\n' "$*" >&2; exit 2; }
warn() { printf '\033[33m[zim-claude]\033[0m %s\n' "$*" >&2; }
info() { printf '\033[36m[zim-claude]\033[0m %s\n' "$*" >&2; }

# --- preconditions -----------------------------------------------------------

[[ -n "$CLAUDE_BIN" ]] \
  || die "claude not found on PATH. Install Claude Code, or set ZIM_CLAUDE_BIN."

# Check it is actually runnable: exec'ing a missing file would surface as a
# bare 127 with no explanation.
[[ -x "$CLAUDE_BIN" ]] \
  || die "claude is not executable: $CLAUDE_BIN"

command -v curl >/dev/null 2>&1 \
  || die "curl is required to reach $BASE_URL, and it is not on PATH."

# --- the terminal ------------------------------------------------------------
#
# Prompts go through /dev/tty rather than stdin, so `zim-claude -p x < file`
# still asks on the terminal the user is looking at. Opening it also tells us
# whether there IS a terminal, which decides whether a missing answer is a
# prompt or a hard error.

_tty_open=0
open_tty() {
  (( _tty_open )) && return 0
  if { exec 3</dev/tty; } 2>/dev/null; then
    _tty_open=1
    return 0
  fi
  return 1
}

close_tty() {
  (( _tty_open )) || return 0
  exec 3<&-
  _tty_open=0
}

# Strip what a copy-paste adds. A trailing CR or space inside the token is a
# 401 that looks like a bad key.
sanitize() {
  printf '%s' "$1" | tr -d ' \t\r\n'
}

# --- the Token Juice notice --------------------------------------------------
#
# Token Juice's unlimited quota ended and the route is gone from this package.
# The notice is one line on stderr, every run, until the user has a key of
# their own — it must never block a session that already works.

API_KEY="${ZIM_CLAUDE_API_KEY:-${TOKENHARBOR_API_KEY:-}}"
API_KEY="$(sanitize "$API_KEY")"

if [[ -z "$API_KEY" && -s "$KEY_FILE" ]]; then
  API_KEY="$(sanitize "$(cat "$KEY_FILE" 2>/dev/null || true)")"
fi

# A key that arrived from the environment is not the user's to retype: if it is
# rejected, say so and stop. Only a key typed at the prompt is worth re-asking.
key_from_env=0
[[ -n "${ZIM_CLAUDE_API_KEY:-}${TOKENHARBOR_API_KEY:-}" ]] && key_from_env=1

if [[ -z "$API_KEY" ]]; then
  warn "Token Juice is currently down — its unlimited quota ended."
fi

# A tj_ key cannot work here any more, and silently sending it to TokenHarbor
# would read as "your key is broken". Name the real reason.
case "$API_KEY" in
  tj_*)
    die "that is a Token Juice key (tj_…), and Token Juice is down:
       its unlimited quota ended, and zim-claude no longer runs against it.
       Create a TokenHarbor key at https://tokenharbor.ai/dashboard/api-keys."
    ;;
esac

# The same rule for the base URL: pointing zim-claude back at Token Juice is
# not a supported configuration, so refuse instead of running a dead route.
case "${ZIM_CLAUDE_BASE_URL:-}" in
  *tokenjuice*)
    die "ZIM_CLAUDE_BASE_URL names Token Juice, which is down.
       Its unlimited quota ended and zim-claude no longer runs against it.
       Unset ZIM_CLAUDE_BASE_URL to use TokenHarbor."
    ;;
esac

# --- the TokenHarbor opt-in --------------------------------------------------

remember_route() {
  mkdir -p -- "$STATE_DIR" 2>/dev/null || return 0
  chmod 700 -- "$STATE_DIR" 2>/dev/null || true
  printf 'tokenharbor\n' >"$ROUTE_FILE" 2>/dev/null || true
}

route_chosen() {
  [[ -r "$ROUTE_FILE" ]] || return 1
  [[ "$(sanitize "$(cat "$ROUTE_FILE" 2>/dev/null || true)")" == "tokenharbor" ]]
}

ask_route() {
  open_tty || return 1
  printf '\n' >&2
  info "Token Juice is down. Use TokenHarbor instead?"
  printf '  [y/N] ' >&2
  local reply=""
  IFS= read -r reply <&3 || reply=""
  printf '\n' >&2
  case "$(printf '%s' "$reply" | tr -d ' \t\r\n' | tr '[:upper:]' '[:lower:]')" in
    y|yes) return 0 ;;
    *) return 1 ;;
  esac
}

case "${ZIM_CLAUDE_USE_TOKENHARBOR:-}" in
  0)
    die "Token Juice is down (unlimited quota ended) and TokenHarbor is switched off.
       Unset ZIM_CLAUDE_USE_TOKENHARBOR, or set it to 1, to run against TokenHarbor."
    ;;
  1)
    remember_route
    ;;
  *)
    if ! route_chosen; then
      if ask_route; then
        remember_route
      elif (( _tty_open )); then
        die "nothing to run against: Token Juice is down (unlimited quota ended)
       and TokenHarbor was declined. Set ZIM_CLAUDE_USE_TOKENHARBOR=1 to use it."
      else
        die "Token Juice is down (unlimited quota ended) and there is no terminal
       to ask on. Set ZIM_CLAUDE_USE_TOKENHARBOR=1 to run against TokenHarbor."
      fi
    fi
    ;;
esac

# --- the API key -------------------------------------------------------------

ask_key() {
  open_tty || return 1
  printf '\n' >&2
  info "TokenHarbor API key — create one at https://tokenharbor.ai/dashboard/api-keys"
  printf '  paste it here (input is hidden): ' >&2
  local typed=""
  IFS= read -r -s typed <&3 || typed=""
  printf '\n' >&2
  API_KEY="$(sanitize "$typed")"
  [[ -n "$API_KEY" ]]
}

# Cache the key the user typed, so the prompt is a first-run cost and not a
# per-session tax. Mode 600 in the state dir, next to the other bookkeeping —
# the same posture as the credential profile this package used to write.
remember_key() {
  [[ -n "$API_KEY" ]] || return 0
  (( key_from_env )) && return 0
  [[ -s "$KEY_FILE" && "$(sanitize "$(cat "$KEY_FILE" 2>/dev/null || true)")" == "$API_KEY" ]] && return 0
  mkdir -p -- "$STATE_DIR" 2>/dev/null || return 0
  chmod 700 -- "$STATE_DIR" 2>/dev/null || true
  ( umask 077; printf '%s\n' "$API_KEY" >"$KEY_FILE" ) 2>/dev/null || true
  chmod 600 -- "$KEY_FILE" 2>/dev/null || true
}

# --- talking to TokenHarbor --------------------------------------------------

HTTP_CODE=""
HTTP_BODY=""

api_get() {
  local out
  # -sS would print curl's own error to stderr; capture the body and status and
  # report both ourselves so the message names the host that failed.
  out="$(curl -sS --max-time 20 \
           -H "Authorization: Bearer $API_KEY" \
           -H 'Accept: application/json' \
           -w $'\n%{http_code}' \
           "$BASE_URL$1" 2>/dev/null)" || out=$'\n000'
  HTTP_CODE="${out##*$'\n'}"
  HTTP_BODY="${out%$'\n'*}"
  [[ "$HTTP_CODE" =~ ^[0-9]{3}$ ]] || HTTP_CODE=000
}

# Pull `"id":"..."` out of the models payload. grep/sed only — jq and python3
# are not dependencies of this package, and the shape here is one flat list.
parse_model_ids() {
  grep -oE '"id"[[:space:]]*:[[:space:]]*"[^"]+"' \
    | sed -E 's/.*"id"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/'
}

# Free routes are advertised with a `:free` suffix (deepseek-v4.1-flash:free,
# mimo-v2.6-flash:free, ...). th-rudder is free without the suffix.
is_free_model() {
  case "$1" in
    *:free|th-rudder) return 0 ;;
    *) return 1 ;;
  esac
}

model_label() {
  case "$1" in
    deepseek-v4.1-flash:free) printf 'DeepSeek V4.1 Flash' ;;
    deepseek-v4-flash:free)   printf 'DeepSeek V4 Flash' ;;
    mimo-v2.6-flash:free)     printf 'MiMo V2.6 Flash' ;;
    mimo-v2.5:free)           printf 'MiMo V2.5' ;;
    th-rudder)                printf 'TH-Rudder' ;;
    *) printf '' ;;
  esac
}

# --- the model picker --------------------------------------------------------

MODEL=""

choose_model() {
  local -a free=()
  local id

  # Free routes first. A paid account still sees them, so this is the normal
  # path either way; if the catalog ever stops advertising any, fall back to
  # the whole list rather than refusing to start.
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    if is_free_model "$id"; then free+=("$id"); fi
  done <<<"$ALL_IDS"

  local note="free models"
  if (( ${#free[@]} == 0 )); then
    while IFS= read -r id; do
      [[ -n "$id" ]] || continue
      free+=("$id")
    done <<<"$ALL_IDS"
    note="no free model is advertised — all models"
  fi

  (( ${#free[@]} > 0 )) || die "$BASE_URL returned no models for this key."

  # A pinned model is an override, not a preference: take it as given so a
  # script can pin a paid model without the picker getting in the way.
  if [[ -n "${ZIM_CLAUDE_MODEL:-}" ]]; then
    MODEL="$ZIM_CLAUDE_MODEL"
    return 0
  fi

  # Default to last time's pick when it is still on offer, so pressing Enter
  # repeatedly is stable instead of drifting to whatever sorts first.
  local default_n=1 previous=""
  if [[ -r "$LAST_MODEL_FILE" ]]; then
    previous="$(sanitize "$(cat "$LAST_MODEL_FILE" 2>/dev/null || true)")"
  fi
  local i
  for i in "${!free[@]}"; do
    if [[ -n "$previous" && "${free[$i]}" == "$previous" ]]; then
      default_n=$((i + 1))
    fi
  done

  open_tty || die "no terminal to choose a model on.
       Set ZIM_CLAUDE_MODEL=<model-id> to skip the picker."

  printf '\n' >&2
  info "$note on ${BASE_URL#https://}"
  for i in "${!free[@]}"; do
    local label; label="$(model_label "${free[$i]}")"
    if [[ -n "$label" ]]; then
      printf '  %2d) %-26s %s\n' "$((i + 1))" "${free[$i]}" "$label" >&2
    else
      printf '  %2d) %s\n' "$((i + 1))" "${free[$i]}" >&2
    fi
  done

  local reply="" choice=""
  while :; do
    printf '  select 1-%d [%d]: ' "${#free[@]}" "$default_n" >&2
    IFS= read -r reply <&3 || reply=""
    reply="$(sanitize "$reply")"
    [[ -z "$reply" ]] && reply="$default_n"
    if [[ "$reply" =~ ^[0-9]+$ ]] && (( reply >= 1 && reply <= ${#free[@]} )); then
      choice="${free[$((reply - 1))]}"
      break
    fi
    warn "not a choice: $reply"
  done
  MODEL="$choice"
}

remember_model() {
  [[ -n "$MODEL" ]] || return 0
  mkdir -p -- "$STATE_DIR" 2>/dev/null || return 0
  chmod 700 -- "$STATE_DIR" 2>/dev/null || true
  printf '%s\n' "$MODEL" >"$LAST_MODEL_FILE" 2>/dev/null || true
}

# --- validate the key and fetch the catalog ----------------------------------

_prev_base_url="${ANTHROPIC_BASE_URL:-}"
attempt=0

while :; do
  if [[ -z "$API_KEY" ]]; then
    if ! ask_key; then
      die "a TokenHarbor API key is required.
       Get one at https://tokenharbor.ai/dashboard/api-keys, then either
       paste it when prompted, or export ZIM_CLAUDE_API_KEY and re-run."
    fi
  fi

  api_get /v1/models

  case "$HTTP_CODE" in
    200) break ;;
    401|403)
      if (( key_from_env )); then
        die "TokenHarbor rejected ZIM_CLAUDE_API_KEY (HTTP $HTTP_CODE).
       Rotate it at https://tokenharbor.ai/dashboard/api-keys."
      fi
      attempt=$((attempt + 1))
      warn "TokenHarbor rejected that key (HTTP $HTTP_CODE)."
      if (( attempt >= 3 )); then
        die "giving up after 3 rejected keys.
       Create or rotate one at https://tokenharbor.ai/dashboard/api-keys."
      fi
      rm -f -- "$KEY_FILE" 2>/dev/null || true
      API_KEY=""
      continue
      ;;
    000)
      die "could not reach $BASE_URL.
       Check your connection, or set ZIM_CLAUDE_BASE_URL if the API lives
       somewhere else."
      ;;
    *)
      die "$BASE_URL/v1/models answered HTTP $HTTP_CODE.
       ${HTTP_BODY:0:300}"
      ;;
  esac
done

# `|| true` because an empty match makes grep exit 1, and pipefail would turn
# that into a silent exit 1 instead of the message below.
ALL_IDS="$(printf '%s\n' "$HTTP_BODY" | parse_model_ids || true)"
[[ -n "$ALL_IDS" ]] \
  || die "$BASE_URL/v1/models returned no model ids for this key.
       ${HTTP_BODY:0:300}"

remember_key
choose_model
remember_model

# --- hand off ----------------------------------------------------------------

close_tty

# Report the override rather than silently changing provider.
if [[ -n "$_prev_base_url" && "$_prev_base_url" != "$BASE_URL" ]]; then
  case "$_prev_base_url" in
    *tokenjuice*|*localhost:4*|*127.0.0.1:4*)
      warn "ignoring inherited ANTHROPIC_BASE_URL=$_prev_base_url (Token Juice is down)" ;;
    *)
      warn "overriding inherited ANTHROPIC_BASE_URL=$_prev_base_url -> $BASE_URL" ;;
  esac
fi

info "model: $MODEL"

# Process-scoped only: plain `claude` in this shell is untouched.
export ANTHROPIC_BASE_URL="$BASE_URL"
export ANTHROPIC_AUTH_TOKEN="$API_KEY"
export ANTHROPIC_MODEL="$MODEL"

# Claude Code names its background and /model-picker calls after Anthropic
# tiers. There is no proxy to rewrite those names now, so point every tier at
# the model that was chosen — otherwise `/model sonnet` asks TokenHarbor for
# "claude-sonnet-4-5" and gets a 404.
export ANTHROPIC_SMALL_FAST_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL"

# Load-bearing. Claude Code prefers ANTHROPIC_AUTH_TOKEN (sent as
# `Authorization: Bearer …`) and falls back to ANTHROPIC_API_KEY (`x-api-key`)
# on a truthiness test, so an empty string means the auth token wins — and it
# also clears any real ANTHROPIC_API_KEY inherited from the shell.
export ANTHROPIC_API_KEY=""

# --- self-update -------------------------------------------------------------

# Bring the installed package up to date in the background. Detached and
# disowned so it can never delay, block or fail this session; the updater
# rate-limits itself, refuses a dirty checkout, and only fast-forwards.
#
# This is what carries a Token Juice-era install onto this version: the next
# run after the update lands is the one that shows the notice and offers
# TokenHarbor.
maybe_self_update() {
  [[ "${ZIM_CLAUDE_NO_UPDATE:-0}" == "1" ]] && return 0

  local updater="$_self_dir/zim-claude-update.sh"
  [[ -x "$updater" ]] || return 0

  # setsid detaches from the terminal's process group so a Ctrl-C, a closed
  # window or a hangup does not kill a half-finished update. Fall back to a
  # plain background job where setsid is unavailable (macOS).
  if command -v setsid >/dev/null 2>&1; then
    setsid "$updater" >/dev/null 2>&1 </dev/null &
  else
    "$updater" >/dev/null 2>&1 </dev/null &
  fi
  disown 2>/dev/null || true
  return 0
}

maybe_self_update

# exec: no extra bash layer, so exit status, signal delivery and TTY ownership
# all belong to claude. NOTE: exec discards EXIT traps — do not add one here.
exec "$CLAUDE_BIN" "$@"
